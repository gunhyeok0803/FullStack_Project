{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(Windows) Launch",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "windows",
      "miDebuggerPath": "C:\\Program Files (x86)\\Windows Kits\\10\\Debuggers\\x64\\cdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for cdb",
          "text": ".nvlist",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "C/C++: cl.exe build active file"
    },
    {
      "name": "(Windows) Attach",
